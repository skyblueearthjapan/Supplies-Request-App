# 見本。VPS では同じフォルダーに .env を作り（chmod 600）、値を入れる。.env は git に入れない。
# 必須の値が欠けていると api と worker は起動しない（fail-closed）。

# staging（切り替えまで）| production（切り替えの日に、オーナーの許可を得てからディレクターが変える）
APP_ENV=staging
PUBLIC_ORIGIN=https://supplies.lineworks-local.net
APP_IMAGE_TAG=latest

# DB（db コンテナの中だけで使う）
POSTGRES_USER=chozouhin
POSTGRES_PASSWORD=
POSTGRES_DB=chozouhin

# Google ログイン（Work Report と同じ GCP プロジェクトの、このアプリ専用 OAuth クライアント）
# 承認済みのリダイレクト URI:
#   https://supplies.lineworks-local.net/auth/callback
#   https://supplies.lineworks-local.net/auth/google-delegate/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_DOMAIN=lineworks-local.info

# セッションの署名鍵（32 文字以上の乱数）: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=14

# 常に管理者（設定 adminEmails が空でもこの人だけ。カンマ区切り）
BOOTSTRAP_ADMINS=imaizumi@lineworks-local.info

# 委任トークン（Gmail 送信・ドライブ・スプレッドシート）を暗号化する鍵
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 鍵を変えると保存済みのトークンが読めなくなる（管理画面から許可し直す）
FERNET_KEY=
DELEGATE_EMAIL=imaizumi@lineworks-local.info

# ===== 安全装置（APP_ENV=staging では全部必須） =====
# メールはすべてここへ寄せる
MAIL_REDIRECT_TO=imaizumi@lineworks-local.info
# 本番の PDF フォルダー（設定 pdfFolderId の値）。ステージングから書かないように照合する
PROD_PDF_FOLDER_ID=
# ステージング用のスプレッドシート（本番のコピー）と PDF フォルダー
STAGING_SPREADSHEET_ID=
STAGING_PDF_FOLDER_ID=
# 本番のスプレッドシート ID はコードに固定（1VKbB13yhJPkyTYu7VYfHm-Zc3sl0nYp0npXUAxau4p4）。ここでは変えられない。

# スプレッドシートへの書き出し（staging は STAGING_SPREADSHEET_ID、production は本番へ）
# この日時（日本時間 yyyy-MM-dd HH:mm）までは毎時、その後は毎晩 2 時台だけ。空なら毎晩だけ。
# 例: 切り替えから 5 営業日の間だけ毎時にする → EXPORT_HOURLY_UNTIL=2026-12-11 18:00
EXPORT_HOURLY_UNTIL=

# Cloudflare Tunnel（supplies-vps）のトークン。転送先は http://chozouhin-web:80
TUNNEL_TOKEN=

# バックアップ
BACKUPS_HOST_PATH=./backups
BACKUP_KEEP_DAYS=14
